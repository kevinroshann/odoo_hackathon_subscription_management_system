PORT=3001
APP_URL=http://localhost:3001
JWT_SECRET=replace-with-output-from-openssl-rand-hex-32
# First admin, created automatically on startup
ADMIN_EMAIL=admin@brightloop.com
ADMIN_PASSWORD=Admin@12345
# SMTP (leave SMTP_HOST empty to print reset links in the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Brightloop <no-reply@brightloop.com>"
# Demo customer + sample subscriptions/invoices (demo@customer.com / Demo@12345)
SEED_DEMO=true
# Skip Member 2 demo products/quotations when the shared database is empty.
SKIP_SEED=false

# Shared SQLite database used by both apps. Leave blank for
# <repo>/data/brightloop.sqlite. Set an absolute path when running from a
# different working directory. DB_FILE takes precedence over DB_PATH.
DB_FILE=
DB_PATH=

# Automatic billing sweep (daily at 02:00 UTC by default).
BILLING_CRON=0 2 * * *
BILLING_TIMEZONE=UTC
# Set to true when only running the HTTP API/tests (no background cron).
DISABLE_BILLING_CRON=false
